# syntax=docker/dockerfile:1

# Stage 1: Builder
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS builder

# Install build dependencies only
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc make libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only what the build needs so unrelated changes keep the cache warm
COPY Makefile ./
COPY src ./src

# Build the release target and strip debug symbols
RUN make -j"$(nproc)" TARGETS=release && strip fh

# Stage 2: Runner
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

LABEL org.opencontainers.image.title="fh" \
      org.opencontainers.image.source="https://github.com/MuresanVladMihail/FH"

# Unprivileged user to run the binary and tests
RUN groupadd --system fh && useradd --system --gid fh --no-create-home --home-dir /app --shell /usr/sbin/nologin fh

WORKDIR /app

COPY --from=builder --chown=fh:fh /app/fh ./
COPY --chown=fh:fh run_tests_release.sh ./
COPY --chown=fh:fh tests ./tests

USER fh

CMD ["./run_tests_release.sh"]
